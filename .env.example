# Copy to .env to override defaults. All variables use the SPINREAD_ prefix.
# Defaults already point at the local docker-compose stack, so .env is optional.

SPINREAD_DB_URL=postgresql+psycopg://spinread:spinread@localhost:5432/spinread
SPINREAD_S3_ENDPOINT=http://localhost:9000
SPINREAD_S3_BUCKET=spinread-media
SPINREAD_S3_ACCESS_KEY=minioadmin
SPINREAD_S3_SECRET_KEY=minioadmin
SPINREAD_JWT_SECRET=dev-only-insecure-secret-change-me
SPINREAD_JWT_TTL_SECONDS=43200
SPINREAD_EMBED_WORKER=true
SPINREAD_TMP_DIR=/tmp/spinread
